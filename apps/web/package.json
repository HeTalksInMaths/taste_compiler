{
  "name": "taste-compiler-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-screenshots": "playwright test --update-snapshots",
    "e2e:results": "node -e \"const r=require('./test-results/results.json');const s=r.suites.flatMap(s=>s.suites??[s]).flatMap(s=>s.specs??[]);const pass=s.filter(t=>t.ok);const fail=s.filter(t=>!t.ok);console.log('PASSED:'+pass.length+' FAILED:'+fail.length);fail.forEach(t=>console.log('FAIL:',t.title,'|',t.tests?.[0]?.results?.[0]?.error?.message?.split('\\n')[0]))\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/react": "^1.0.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1065.0",
    "ai": "^4.3.19",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
