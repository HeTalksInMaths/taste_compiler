# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Payment mode (independent of simulation mode)
# Derives from STRIPE_SECRET_KEY prefix if not set explicitly
# Values: test | live | simulated
# PAYMENT_MODE_OVERRIDE=

# Simulation mode (controls whether simulation creates real Stripe sessions)
# Values: mock_only | stripe_test_checkout
MARKET_SIM_MODE=mock_only

# Stripe test session cap for simulation mixed mode
STRIPE_TEST_SESSION_CAP=50

# Platform
PLATFORM_FEE_PERCENT=25

# Storage adapter: memory | postgres | dynamodb
STORAGE_ADAPTER=memory

# Artifact adapter: local | s3 | vercel-blob
ARTIFACT_ADAPTER=local

# Auth adapter: mock | jwt
AUTH_ADAPTER=mock

# AWS (when using dynamodb/s3)
# DYNAMODB_TABLE_NAME=evalweaver
# ARTIFACT_S3_BUCKET=evalweaver-artifacts
# AWS_REGION=ap-southeast-1
